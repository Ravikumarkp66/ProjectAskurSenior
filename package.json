{
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:perf:db": "node performance/db-profiler.js",
    "test:perf:load": "node performance/load-tester.js",
    "test:perf:journey": "playwright test performance/user-journey.bench.spec.js --project=performance",
    "test:perf:all": "node performance/run-benchmarks.js",
    "test:performance": "npm run test:perf:all",
    "test:performance:db": "npm run test:perf:db",
    "test:performance:load": "npm run test:perf:load",
    "test:performance:journey": "npm run test:perf:journey",
    "test:admin-e2e": "playwright test --project=admin-setup --project=admin-e2e --project=admin-teardown --workers=1",
    "test:admin-e2e:headed": "playwright test --project=admin-setup --project=admin-e2e --project=admin-teardown --workers=1 --headed",
    "test:admin-e2e:ui": "playwright test --project=admin-e2e --workers=1 --ui",
    "test:unit:frontend": "npm --prefix frontend run test:unit",
    "test:unit:backend": "npm --prefix backend run test:unit",
    "test:integration": "npm --prefix backend run test:integration",
    "test:api": "npm --prefix backend run test:api",
    "test:regression:unit": "npm run test:unit:frontend && npm run test:unit:backend && npm run test:integration",
    "test:regression:e2e": "playwright test --grep @regression --project=public-chromium",
    "test:regression:admin-e2e": "playwright test --grep @regression --project=admin-setup --project=admin-e2e --project=admin-teardown --workers=1",
    "test:regression": "npm run test:regression:unit && npm run test:regression:e2e",
    "test:regression:full": "npm run test:regression && npm run test:regression:admin-e2e",
    "test:coverage:frontend": "npm --prefix frontend run test:coverage",
    "test:coverage:backend": "npm --prefix backend run test:coverage",
    "test:coverage": "npm run test:coverage:frontend && npm run test:coverage:backend",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:admin": "npm --prefix admin run lint",
    "lint:backend": "npm --prefix backend run lint",
    "lint": "npm run lint:frontend && npm run lint:admin && npm run lint:backend",
    "test:security:backend": "npm --prefix backend run test:security",
    "test:security:e2e": "playwright test --grep @security --project=public-chromium",
    "test:security:admin-e2e": "playwright test --grep @security --project=admin-setup --project=admin-e2e --project=admin-teardown --workers=1",
    "test:security": "npm run test:security:backend && npm run test:security:e2e",
    "test:accessibility:student": "playwright test e2e/accessibility.spec.js --project=public-chromium",
    "test:accessibility:admin": "playwright test admin-e2e/13-accessibility.spec.js --project=admin-setup --project=admin-e2e --project=admin-teardown --workers=1",
    "test:accessibility": "npm run test:accessibility:student"
  },
  "dependencies": {
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "mongodb": "^7.6.0"
  }
}
