# AskUrSenior Admin Environment Variables

# Local Development (Proxy or direct port)
# VITE_API_URL=http://localhost:5000/api

# Staging Environment (EC2 deployment)
# VITE_API_URL=https://api-staging.askursenior.org
# or relative /api if served behind reverse proxy (e.g. Nginx)
VITE_API_URL=http://localhost:5000/api
