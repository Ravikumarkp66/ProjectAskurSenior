# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Security
JWT_SECRET=your_super_secret_jwt_key_here
ADMIN_EMAIL=admin@askursenior.org

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# AWS S3 (Storage for Notes, PYQs, Lab Manuals, Profile Pictures)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=your_bucket_name

# AI & LLM Providers
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key_here

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Performance & Caching (Optional)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Code Execution Sandbox (Local Docker on EC2)
# The backend directly orchestrates Docker containers on the host EC2 instance.
CODE_EXECUTION_TIMEOUT_MS=4000
CODE_EXECUTION_MEMORY_LIMIT=128m
CODE_EXECUTION_CPU_LIMIT=1
CODE_EXECUTION_PIDS_LIMIT=64
CODE_EXECUTION_OUTPUT_LIMIT_BYTES=1048576
