# Server Configuration
PORT=5000
NODE_ENV=production

# Database
MONGODB_URI=mongodb+srv://...

# Security
JWT_SECRET=your_super_secret_jwt_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Note: For Google OAuth to work in production:
# 1. Go to Google Cloud Console (console.cloud.google.com)
# 2. Select your project
# 3. Go to "APIs & Services" > "Credentials"
# 4. Add your frontend domain to "Authorized JavaScript origins"
# 5. Add your backend domain to "Authorized redirect URIs"

# AWS S3 (Profile Pictures)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=your_bucket_name

# Email (Forgot Password)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password
FROM_NAME=AskUrSenior
FROM_EMAIL=noreply@askursenior.com

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Performance & Deployment
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
SELF_URL=https://your-backend-render-url.onrender.com
